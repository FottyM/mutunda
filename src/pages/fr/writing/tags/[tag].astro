---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import WritingTagPage from "../../../../templates/WritingTagPage.astro";

export const getStaticPaths = (async () => {
  const allEntries = await getCollection("writing", ({ data }) => !data.draft);
  const frenchEntries = allEntries.filter((e) => (e.data.locale ?? "en") === "fr");

  const getEntrySlug = (e: typeof allEntries[0]) =>
    e.data.slug ?? e.id.replace(/\.(fr|et)$/, "").replace(/^(fr|et)\//, "");

  const tags = new Map<string, { label: string; entries: Array<{ entry: CollectionEntry<"writing">; slug: string }> }>();
  const tagSlug = (tag: string) => tag.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

  for (const entry of frenchEntries) {
    const slug = getEntrySlug(entry);
    for (const label of entry.data.tags) {
      const s = tagSlug(label);
      const group = tags.get(s) ?? { label, entries: [] };
      group.entries.push({ entry, slug });
      tags.set(s, group);
    }
  }

  return [...tags.entries()].map(([tag, group]) => ({
    params: { tag },
    props: { label: group.label, tag, entries: group.entries },
  }));
}) satisfies GetStaticPaths;

interface Props {
  label: string;
  tag: string;
  entries: Array<{ entry: CollectionEntry<"writing">; slug: string }>;
}

const { label, tag, entries } = Astro.props;
---

<WritingTagPage label={label} tag={tag} entries={entries} locale="fr" />
