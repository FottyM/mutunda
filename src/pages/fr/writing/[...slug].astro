---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import WritingDetailPage from "../../../templates/WritingDetailPage.astro";
import { LOCALES, type Locale } from "../../../i18n/config";
import { getLocalizedPath } from "../../../i18n/utils";

export const getStaticPaths = (async () => {
  const allEntries = await getCollection("writing", ({ data }) => !data.draft);
  const frenchEntries = allEntries.filter((e) => (e.data.locale ?? "en") === "fr");

  const getEntrySlug = (e: typeof allEntries[0]) =>
    e.data.slug ?? e.id.replace(/\.(fr|et)$/, "").replace(/^(fr|et)\//, "");

  return frenchEntries.map((entry) => {
    const slug = getEntrySlug(entry);
    const translations: Partial<Record<Locale, string>> = {};
    for (const loc of LOCALES) {
      const hasTranslation = allEntries.some((e) => getEntrySlug(e) === slug && (e.data.locale ?? "en") === loc);
      if (hasTranslation) {
        translations[loc] = getLocalizedPath(`/writing/${slug}`, loc);
      }
    }
    return {
      params: { slug },
      props: { entry, slug, translations },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<"writing">;
  slug: string;
  translations: Partial<Record<Locale, string>>;
}

const { entry, slug, translations } = Astro.props;
---

<WritingDetailPage entry={entry} slug={slug} locale="fr" translations={translations} />
