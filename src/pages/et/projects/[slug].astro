---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import ProjectDetailPage from "../../../templates/ProjectDetailPage.astro";
import { LOCALES, type Locale } from "../../../i18n/config";
import { getLocalizedPath } from "../../../i18n/utils";

export const getStaticPaths = (async () => {
  const allProjects = await getCollection("projects", ({ data }) => !data.draft);
  const etProjects = allProjects.filter((p) => (p.data.locale ?? "en") === "et");

  return etProjects.map((project) => {
    const slug = project.data.slug;
    const translations: Partial<Record<Locale, string>> = {};
    for (const loc of LOCALES) {
      const hasTranslation = allProjects.some((p) => p.data.slug === slug && (p.data.locale ?? "en") === loc);
      if (hasTranslation) {
        translations[loc] = getLocalizedPath(`/projects/${slug}`, loc);
      }
    }
    return {
      params: { slug },
      props: { project, translations },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<"projects">;
  translations: Partial<Record<Locale, string>>;
}

const { project, translations } = Astro.props;
---

<ProjectDetailPage project={project} locale="et" translations={translations} />
