---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialIcon from "../components/SocialIcon.astro";
---

<BaseLayout
  title="About — Fortunat Mutunda"
  description="About Fortunat Mutunda, a software engineer based in Tallinn, Estonia."
>
  <main id="main-content" class="about-page">
    <header class="page-header">
      <p class="eyebrow">About</p>
      <h1>Engineering for the whole system.</h1>
    </header>
    <div class="about-page__body prose">
      <figure class="profile-portrait">
        <img
          src="https://avatars.githubusercontent.com/u/227173828?v=4"
          alt="Fortunat Mutunda"
          width="460"
          height="460"
          loading="eager"
        />
      </figure>
      <p class="lede">
        I'm Fortunat Mutunda, a software engineer based in Tallinn, Estonia. I
        build web platforms, developer tools, and backend systems with JavaScript,
        TypeScript, and Rust.
      </p>
      <p>
        My work tends to sit where product interfaces meet operational concerns:
        data quality, automation, delivery, and the small decisions that make a
        system easier to understand and maintain.
      </p>
      <p>
        This site is the working record of those projects and the technical ideas
        behind them.
      </p>
      <section class="profile-links" aria-labelledby="profiles-heading">
        <h2 id="profiles-heading">Profiles</h2>
        <ul>
          <li><a href="https://github.com/FottyM"><SocialIcon name="github" />FottyM <span class="visually-hidden">(primary profile)</span></a></li>
          <li><a href="https://www.linkedin.com/in/fortunat-mutunda/"><SocialIcon name="linkedin" />LinkedIn</a></li>
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>
