---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import Tag from "../components/Tag.astro";
import { getCollection } from "astro:content";

const featuredProjects = await getCollection(
  "projects",
  ({ data }) => !data.draft && data.featured,
);
const profileStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Fortunat Mutunda",
  url: Astro.site?.href,
  sameAs: [
    "https://github.com/FottyM",
    "https://www.linkedin.com/in/fortunat-mutunda/",
  ],
  jobTitle: "Software engineer",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Tallinn",
    addressCountry: "EE",
  },
};
---

<BaseLayout
  title="Fortunat Mutunda — Software Engineer"
  description="Fortunat Mutunda is a software engineer working across web platforms, developer tools, and backend systems."
  structuredData={profileStructuredData}
>
  <main id="main-content">
    <section class="intro field-sheet" aria-labelledby="intro-heading">
      <div class="field-sheet__index" aria-hidden="true">
        <span>Field note</span>
        <span>001 / 2026</span>
      </div>
      <div class="intro__content">
        <p class="eyebrow">Software engineer · Tallinn, Estonia</p>
        <h1 id="intro-heading">Fortunat<br />Mutunda</h1>
        <p class="lede">
          I build reliable web platforms, developer tools, and backend systems with
          JavaScript, TypeScript, and Rust.
        </p>
      </div>
      <div class="intro__margin-note" aria-label="Areas of practice">
        <span>Practice</span>
        <p>Web platforms<br />Developer tooling<br />Backend systems</p>
      </div>
    </section>

    <section class="home-section" aria-labelledby="selected-work-heading">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2 id="selected-work-heading">Systems built for real conditions.</h2>
      </div>
      <div class="card-grid">
        {featuredProjects.map(({ data: project }) => (
          <Card title={project.title} eyebrow={`${project.year} · ${project.role}`} href={`/projects/${project.slug}`}>
            <p>{project.summary}</p>
            <div class="tag-row" aria-label="Technologies">
              {project.technologies.slice(0, 3).map((technology) => <Tag>{technology}</Tag>)}
            </div>
          </Card>
        ))}
      </div>
      <a class="text-link" href="/projects">View all projects <span aria-hidden="true">&rarr;</span></a>
    </section>

    <section class="home-section home-about" aria-labelledby="home-about-heading">
      <p class="eyebrow">About</p>
      <div>
        <h2 id="home-about-heading">Software engineering with an operational point of view.</h2>
        <p>
          I work across web platforms, developer tooling, and backend systems,
          with an emphasis on dependable delivery and clear interfaces.
        </p>
        <a class="text-link" href="/about">More about my work <span aria-hidden="true">&rarr;</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
