---
import "../styles/tokens.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import LanguageSelector from "../components/LanguageSelector.astro";
import ThemeControl from "../components/ThemeControl.astro";
import CommandPalette from "../components/CommandPalette.astro";
import { DEFAULT_LOCALE, type Locale } from "../i18n/config";
import { useTranslations } from "../i18n/translations";
import { getLocaleMetadata, getLocalizedPath } from "../i18n/utils";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  canonical?: URL | string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  openGraphType?: "website" | "article";
  publishedTime?: string;
  image?: string | ImageMetadata;
  imageAlt?: string;
  locale?: Locale;
  translations?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  canonical,
  structuredData,
  openGraphType = "website",
  publishedTime,
  image,
  imageAlt,
  locale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE,
  translations,
} = Astro.props;

const t = useTranslations(locale);
const { canonicalUrl, alternates } = getLocaleMetadata(Astro.site, Astro.url.pathname, translations);
const finalCanonical = canonical ? (typeof canonical === "string" ? canonical : canonical.href) : canonicalUrl;
const imageSrc = typeof image === "object" && image !== null && "src" in image ? image.src : image;
const imageUrl = imageSrc && new URL(imageSrc, Astro.site ?? Astro.url).href;
const structuredDataJson = structuredData && JSON.stringify(structuredData).replace(/</g, "\\u003c");

const navItems = [
  { path: "/", label: t("nav.home") },
  { path: "/projects", label: t("nav.projects") },
  { path: "/writing", label: t("nav.writing") },
  { path: "/about", label: t("nav.about") },
];

const homeUrl = getLocalizedPath("/", locale);
const navigation = navItems.map((item) => ({
  href: getLocalizedPath(item.path, locale),
  label: item.label,
}));

const isCurrent = (href: string) =>
  href === homeUrl ? Astro.url.pathname === href : Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={finalCanonical} />
    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content="Fortunat Mutunda" />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={finalCanonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        function applyStoredTheme() {
          try {
            var storedTheme = localStorage.getItem("theme");
            if (storedTheme === "light" || storedTheme === "dark") {
              document.documentElement.setAttribute("data-theme", storedTheme);
            } else {
              document.documentElement.removeAttribute("data-theme");
            }
          } catch (e) {
            // Keep the server-rendered system theme when storage is unavailable.
          }
        }

        applyStoredTheme();
        // ClientRouter swaps the <html> element's attributes during navigation.
        // Restore an explicit preference before the incoming page is painted.
        document.addEventListener("astro:after-swap", applyStoredTheme);

        // Browser history alone cannot tell whether a primary-nav destination
        // sits to the left or right of the current section. Give the router a
        // semantic direction so Home ← Projects ← Writing ← About reads naturally.
        var primarySections = ["", "projects", "writing", "about"];
        function primarySectionIndex(url) {
          var segments = url.pathname.split("/").filter(Boolean);
          if (segments[0] === "fr" || segments[0] === "et") segments.shift();
          var section = segments[0] || "";
          return primarySections.indexOf(section);
        }

        document.addEventListener("astro:before-preparation", function (event) {
          var fromIndex = primarySectionIndex(event.from);
          var toIndex = primarySectionIndex(event.to);
          if (fromIndex < 0 || toIndex < 0 || fromIndex === toIndex) {
            event.direction = "same";
          } else {
            event.direction = toIndex > fromIndex ? "next" : "previous";
          }
        });
      })();
    </script>
    <script is:inline>
      (function () {
        function markLoaded(img) {
          img.classList.add("is-loaded");
          var container = img.closest(".progressive-image");
          if (container) container.classList.add("is-loaded");
        }

        function checkImages() {
          var targets = document.querySelectorAll(".progressive-image__target, .prose img");
          for (var i = 0; i < targets.length; i++) {
            var img = targets[i];
            if (img.complete && img.naturalWidth > 0) {
              markLoaded(img);
            } else {
              img.addEventListener("load", function (e) { markLoaded(e.target); }, { once: true });
            }
          }
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", checkImages);
        } else {
          checkImages();
        }
        document.addEventListener("astro:page-load", checkImages);
      })();
    </script>
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t("skip_link")}</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="wordmark" href={homeUrl} aria-label={t("wordmark.aria")}>
          <span class="wordmark__mark" aria-hidden="true">FM</span>
          <span>Fortunat Mutunda</span>
        </a>
        <div class="site-header__actions">
          <nav aria-label={t("nav.primary")}>
            <ul>
              {navigation.map(({ href, label }) => (
                <li><a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a></li>
              ))}
            </ul>
          </nav>
          <div class="site-header__divider" aria-hidden="true"></div>
          <div class="site-header__controls">
            <CommandPalette locale={locale} translations={translations} />
            <ThemeControl locale={locale} />
            <LanguageSelector currentLocale={locale} translations={translations} />
          </div>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>&copy; {new Date().getFullYear()} {t("footer.copyright")}</p>
        <p class="site-footer__note">{t("footer.note")}</p>
      </div>
    </footer>
  </body>
</html>
