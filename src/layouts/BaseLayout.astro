---
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: URL | string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  openGraphType?: "website" | "article";
  publishedTime?: string;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site),
  structuredData,
  openGraphType = "website",
  publishedTime,
} = Astro.props;
const canonicalUrl = typeof canonical === "string" ? canonical : canonical.href;
const structuredDataJson = structuredData && JSON.stringify(structuredData).replace(/</g, "\\u003c");
const navigation = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
  { href: "/about", label: "About" },
];

const isCurrent = (href: string) =>
  href === "/" ? Astro.url.pathname === href : Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta property="og:site_name" content="Fortunat Mutunda" />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="wordmark" href="/" aria-label="Fortunat Mutunda, home">
          <span class="wordmark__mark" aria-hidden="true">FM</span>
          <span>Fortunat Mutunda</span>
        </a>
        <nav aria-label="Primary">
          <ul>
            {navigation.map(({ href, label }) => (
              <li><a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>&copy; {new Date().getFullYear()} Fortunat Mutunda</p>
        <p class="site-footer__note">Built as a quiet place for work and writing.</p>
      </div>
    </footer>
  </body>
</html>
