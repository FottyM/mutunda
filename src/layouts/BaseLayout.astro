---
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: URL | string;
}

const { title, description, canonical = new URL(Astro.url.pathname, Astro.site) } = Astro.props;
const navigation = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
  { href: "/about", label: "About" },
];

const isCurrent = (href: string) =>
  href === "/" ? Astro.url.pathname === href : Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="wordmark" href="/" aria-label="Fortunat Mutunda, home">
          <span class="wordmark__mark" aria-hidden="true">FM</span>
          <span>Fortunat Mutunda</span>
        </a>
        <nav aria-label="Primary">
          <ul>
            {navigation.map(({ href, label }) => (
              <li><a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>&copy; {new Date().getFullYear()} Fortunat Mutunda</p>
        <p class="site-footer__note">Built as a quiet place for work and writing.</p>
      </div>
    </footer>
  </body>
</html>
