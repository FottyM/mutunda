---
import { LOCALES, LOCALE_LABELS, type Locale } from "../i18n/config";
import { getLocaleFallbackPath, getLocalizedPath } from "../i18n/utils";
import { useTranslations } from "../i18n/translations";
import FlagIcon from "./FlagIcon.astro";

interface Props {
  currentLocale: Locale;
  translations?: Partial<Record<Locale, string>>;
}

const { currentLocale, translations } = Astro.props;
const t = useTranslations(currentLocale);
const currentLabel = LOCALE_LABELS[currentLocale].nativeName;
---

<div class="language-selector">
  <button
    type="button"
    class="language-selector__trigger"
    id="language-selector-trigger"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="language-selector-menu"
    title={`${t("lang.select")} (${currentLabel})`}
    aria-label={`${t("lang.select")} (${currentLabel})`}
  >
    <span class="language-selector__code" aria-hidden="true">{currentLocale.toUpperCase()}</span>
    <span class="visually-hidden">{currentLabel}</span>
  </button>

  <div
    class="language-selector__menu"
    id="language-selector-menu"
    role="menu"
    aria-label={t("nav.language")}
  >
    <ul class="language-selector__list" role="none">
      {LOCALES.map((locale) => {
        const isCurrent = locale === currentLocale;
        const targetPath = translations?.[locale]
          ?? (translations ? getLocaleFallbackPath(Astro.url.pathname, locale) : getLocalizedPath(Astro.url.pathname, locale));
        const nativeName = LOCALE_LABELS[locale].nativeName;
        const uppercaseCode = locale.toUpperCase();

        return (
          <li class="language-selector__item" role="none">
            {isCurrent ? (
              <span
                class="language-selector__option language-selector__option--current"
                role="menuitem"
                tabindex="0"
                aria-current="true"
                aria-label={t("lang.current", { lang: nativeName })}
              >
                <FlagIcon locale={locale} />
                <span class="language-selector__name">{nativeName}</span>
                <span class="language-selector__badge">{uppercaseCode}</span>
              </span>
            ) : (
              <a
                href={targetPath}
                hreflang={locale}
                lang={locale}
                class="language-selector__option language-selector__link"
                role="menuitem"
                aria-label={t("lang.switch_to", { lang: nativeName })}
              >
                <FlagIcon locale={locale} />
                <span class="language-selector__name">{nativeName}</span>
                <span class="language-selector__badge">{uppercaseCode}</span>
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</div>

<script>
  function setupLanguageSelector() {
    const trigger = document.getElementById("language-selector-trigger") as HTMLButtonElement | null;
    const menu = document.getElementById("language-selector-menu") as HTMLElement | null;
    if (!trigger || !menu) return;

    function openMenu() {
      trigger?.setAttribute("aria-expanded", "true");
      menu?.classList.add("is-open");
      const currentOrFirst = (menu?.querySelector(".language-selector__option--current") ||
        menu?.querySelector(".language-selector__option")) as HTMLElement | null;
      currentOrFirst?.focus();
    }

    function closeMenu(focusTrigger = true) {
      trigger?.setAttribute("aria-expanded", "false");
      menu?.classList.remove("is-open");
      if (focusTrigger && trigger) {
        trigger.focus();
      }
    }

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        closeMenu(false);
      } else {
        openMenu();
      }
    });

    menu.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        e.preventDefault();
        closeMenu(true);
      } else if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        const options = Array.from(menu.querySelectorAll<HTMLElement>(".language-selector__option"));
        const currentIndex = options.indexOf(document.activeElement as HTMLElement);
        let nextIndex = e.key === "ArrowDown" ? currentIndex + 1 : currentIndex - 1;
        if (nextIndex < 0) nextIndex = options.length - 1;
        if (nextIndex >= options.length) nextIndex = 0;
        options[nextIndex]?.focus();
      }
    });

    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node) && !trigger.contains(e.target as Node)) {
        if (trigger.getAttribute("aria-expanded") === "true") {
          closeMenu(false);
        }
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && trigger.getAttribute("aria-expanded") === "true") {
        closeMenu(true);
      }
    });
  }

  setupLanguageSelector();
  document.addEventListener("astro:page-load", setupLanguageSelector);
</script>
