---
import { icons } from "lucide";

interface Props {
  name: keyof typeof icons;
  size?: number | string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 16, class: className, strokeWidth = 2 } = Astro.props;
const iconNodes = icons[name];
---

{iconNodes && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
    focusable="false"
  >
    {iconNodes.map(([tag, attrs]) => {
      const Tag = tag as any;
      return <Tag {...attrs} />;
    })}
  </svg>
)}
