---
import Icon from "./Icon.astro";
import type { Locale } from "../i18n/config";
import { useTranslations } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="theme-control">
  <button
    type="button"
    class="theme-toggle"
    id="theme-toggle"
    title={t("theme.label")}
    aria-label={t("theme.label")}
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="theme-menu"
  >
    <span class="theme-toggle__icon theme-toggle__icon--system" aria-hidden="true">
      <Icon name="Monitor" size={15} />
    </span>
    <span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true">
      <Icon name="Sun" size={15} />
    </span>
    <span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true">
      <Icon name="Moon" size={15} />
    </span>
  </button>

  <div
    class="theme-menu"
    id="theme-menu"
    role="menu"
    aria-label={t("theme.label")}
  >
    <ul class="theme-menu__list" role="none">
      <li class="theme-menu__item" role="none">
        <button
          type="button"
          class="theme-menu__option"
          data-theme-set="system"
          role="menuitem"
          aria-label={t("theme.system")}
        >
          <Icon name="Monitor" size={14} class="theme-menu__icon" />
          <span class="theme-menu__name">{t("theme.system")}</span>
          <span class="theme-menu__check" aria-hidden="true">
            <Icon name="Check" size={13} />
          </span>
        </button>
      </li>
      <li class="theme-menu__item" role="none">
        <button
          type="button"
          class="theme-menu__option"
          data-theme-set="light"
          role="menuitem"
          aria-label={t("theme.light")}
        >
          <Icon name="Sun" size={14} class="theme-menu__icon" />
          <span class="theme-menu__name">{t("theme.light")}</span>
          <span class="theme-menu__check" aria-hidden="true">
            <Icon name="Check" size={13} />
          </span>
        </button>
      </li>
      <li class="theme-menu__item" role="none">
        <button
          type="button"
          class="theme-menu__option"
          data-theme-set="dark"
          role="menuitem"
          aria-label={t("theme.dark")}
        >
          <Icon name="Moon" size={14} class="theme-menu__icon" />
          <span class="theme-menu__name">{t("theme.dark")}</span>
          <span class="theme-menu__check" aria-hidden="true">
            <Icon name="Check" size={13} />
          </span>
        </button>
      </li>
    </ul>
  </div>
</div>

<script>
  function setupThemeControl() {
    const trigger = document.getElementById("theme-toggle") as HTMLButtonElement | null;
    const menu = document.getElementById("theme-menu") as HTMLElement | null;
    const options = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-theme-set]"));
    if (!trigger || !menu) return;

    function getStoredTheme(): "light" | "dark" | "system" {
      try {
        const stored = localStorage.getItem("theme");
        if (stored === "light" || stored === "dark") return stored;
      } catch (e) {}
      return "system";
    }

    function openMenu() {
      trigger?.setAttribute("aria-expanded", "true");
      menu?.classList.add("is-open");

      // Close language menu if open to avoid overlap
      const langTrigger = document.getElementById("language-selector-trigger");
      const langMenu = document.getElementById("language-selector-menu");
      if (langTrigger?.getAttribute("aria-expanded") === "true") {
        langTrigger.setAttribute("aria-expanded", "false");
        langMenu?.classList.remove("is-open");
      }

      const activeOpt = menu?.querySelector<HTMLElement>(".theme-menu__option.is-active") || options[0];
      activeOpt?.focus();
    }

    function closeMenu(focusTrigger = true) {
      trigger?.setAttribute("aria-expanded", "false");
      menu?.classList.remove("is-open");
      if (focusTrigger && trigger) {
        trigger.focus();
      }
    }

    function applyTheme(theme: "light" | "dark" | "system", withTransition = true) {
      const update = () => {
        if (theme === "system") {
          document.documentElement.removeAttribute("data-theme");
          try {
            localStorage.removeItem("theme");
          } catch (e) {}
        } else {
          document.documentElement.setAttribute("data-theme", theme);
          try {
            localStorage.setItem("theme", theme);
          } catch (e) {}
        }
        updateActiveStates();
      };

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const canTransition = typeof document.startViewTransition === "function" && !prefersReducedMotion && withTransition;

      if (canTransition) {
        document.documentElement.classList.add("theme-transitioning");
        const transition = document.startViewTransition(update);
        transition.finished.finally(() => {
          document.documentElement.classList.remove("theme-transitioning");
        });
      } else {
        update();
      }
    }

    function updateActiveStates() {
      const current = getStoredTheme();
      options.forEach((opt) => {
        const isActive = opt.dataset.themeSet === current;
        opt.classList.toggle("is-active", isActive);
        opt.setAttribute("aria-selected", isActive ? "true" : "false");
      });
    }

    updateActiveStates();

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        closeMenu(false);
      } else {
        openMenu();
      }
    });

    options.forEach((opt) => {
      opt.addEventListener("click", () => {
        const theme = opt.dataset.themeSet as "light" | "dark" | "system";
        applyTheme(theme, true);
        closeMenu(true);
      });
    });

    menu.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        e.preventDefault();
        closeMenu(true);
      } else if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        const currentIndex = options.indexOf(document.activeElement as HTMLButtonElement);
        let nextIndex = e.key === "ArrowDown" ? currentIndex + 1 : currentIndex - 1;
        if (nextIndex < 0) nextIndex = options.length - 1;
        if (nextIndex >= options.length) nextIndex = 0;
        options[nextIndex]?.focus();
      }
    });

    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node) && !trigger.contains(e.target as Node)) {
        if (trigger.getAttribute("aria-expanded") === "true") {
          closeMenu(false);
        }
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && trigger.getAttribute("aria-expanded") === "true") {
        closeMenu(true);
      }
    });

    window.addEventListener("theme:set", ((e: CustomEvent<"light" | "dark" | "system">) => {
      if (e.detail) {
        applyTheme(e.detail, true);
      }
    }) as EventListener);
  }

  setupThemeControl();
  document.addEventListener("astro:page-load", setupThemeControl);
</script>
