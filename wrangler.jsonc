{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mutunda",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "previews": {},
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
